<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- AND-010: HTTPS only and system CAs only by default. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- TEMPORARY EXCEPTION: the current production gateway has no TLS yet (http://169.58.239.251:8088,
         MQTT 1883). Remove this block once the server serves HTTPS and pin its certificate. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">169.58.239.251</domain>
    </domain-config>

    <!-- Debug builds only: user-installed CAs for proxy inspection. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
