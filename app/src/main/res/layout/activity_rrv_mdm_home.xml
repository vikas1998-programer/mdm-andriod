<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_corporate_wallpaper">

    <!-- ======================================================== -->
    <!-- 1. Centered Geometric Watermark                           -->
    <!-- ======================================================== -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:alpha="0.12"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.65">

        <ImageView
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:src="@drawable/ic_rrv_watermark"
            android:contentDescription="RRV Watermark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="RRV MDM"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:letterSpacing="0.2"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ======================================================== -->
    <!-- 2. Top Header Bar                                         -->
    <!-- ======================================================== -->
    <LinearLayout
        android:id="@+id/layoutTopHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingTop="36dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RRV MDM"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHeaderSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Managed by RRV MDM"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Notification Bell with Badge -->
        <FrameLayout
            android:id="@+id/btnNotifications"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_bell"
                android:contentDescription="Notifications" />

            <TextView
                android:id="@+id/tvNotificationBadge"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_status_pill"
                android:backgroundTint="#EF4444"
                android:gravity="center"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />
        </FrameLayout>

        <!-- Managed Settings Icon -->
        <ImageView
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_gear"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Settings" />
    </LinearLayout>

    <!-- ======================================================== -->
    <!-- 3. Large Clock & Weather Capsule                          -->
    <!-- ======================================================== -->
    <LinearLayout
        android:id="@+id/layoutClockContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutTopHeader">

        <!-- Time Display -->
        <TextView
            android:id="@+id/tvClockTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10:36"
            android:textColor="#FFFFFF"
            android:textSize="52sp"
            android:fontFamily="sans-serif-medium"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="4"
            android:shadowRadius="10" />

        <!-- Date & Location -->
        <TextView
            android:id="@+id/tvClockDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wed, Oct 24 • Seattle"
            android:textColor="#CBD5E1"
            android:textSize="14sp" />

        <!-- Weather Widget Capsule -->
        <LinearLayout
            android:id="@+id/layoutWeatherWidget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_weather_sun"
                android:contentDescription="Weather Sun" />

            <TextView
                android:id="@+id/tvWeatherText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="70° Sunny"
                android:textColor="#FBBF24"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- ======================================================== -->
    <!-- 4. Floating Admin Broadcast Message Card                  -->
    <!-- ======================================================== -->
    <LinearLayout
        android:id="@+id/cardAdminMessage"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/bg_admin_msg_card"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutClockContainer"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📢"
            android:textSize="18sp"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAdminMsgTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Admin Message"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAdminMsgBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Please connect device to Wi-Fi for mandatory synchronization."
                android:textColor="#CBD5E1"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnDismissAdminMsg"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#94A3B8"
            android:contentDescription="Dismiss" />
    </LinearLayout>

    <!-- ======================================================== -->
    <!-- 5. Dynamic Managed Applications Grid                      -->
    <!-- ======================================================== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAppGrid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/cardCommandStatus"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardAdminMessage" />

    <LinearLayout
        android:id="@+id/layoutEmptyApps"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/cardCommandStatus"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardAdminMessage">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛡️"
            android:textSize="44sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Device Managed"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="No applications enabled by IT Administrator"
            android:textColor="#94A3B8"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- ======================================================== -->
    <!-- 6. Floating Temporary Command Status Card (e.g. Install)  -->
    <!-- ======================================================== -->
    <LinearLayout
        android:id="@+id/cardCommandStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_command_card"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomStatus"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RRV MDM"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/tvCommandCardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Application installation"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCommandCardSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RRV Secure Browser"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/pbCommandProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="72"
            android:progressDrawable="@drawable/bg_status_badge_green" />

        <TextView
            android:id="@+id/tvCommandStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Installing application..."
            android:textColor="#38BDF8"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- ======================================================== -->
    <!-- 7. Bottom Navigation & Status Pill Bar                     -->
    <!-- ======================================================== -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutBottomStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Bottom Left Security Pill -->
        <LinearLayout
            android:id="@+id/pillDeviceSecurity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_pill"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivSecurityShield"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_shield_check"
                android:contentDescription="Shield Icon" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSecurityStatusTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Device is secure"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSecurityLastSynced"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Last synced: 10:30 AM"
                    android:textColor="#94A3B8"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Center Pagination Dots & Chevron -->
        <LinearLayout
            android:id="@+id/layoutPaginationDots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/pillCompliantBadge"
            app:layout_constraintStart_toEndOf="@id/pillDeviceSecurity"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="• ○"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:letterSpacing="0.3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌃"
                android:textColor="#64748B"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Bottom Right "Compliant ✓" Badge -->
        <TextView
            android:id="@+id/pillCompliantBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_badge_green"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:text="Compliant ✓"
            android:textColor="#10B981"
            android:textSize="11sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
