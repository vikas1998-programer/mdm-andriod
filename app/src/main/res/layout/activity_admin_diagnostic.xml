<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_space"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛠️ Admin Diagnostics &amp; Telemetry"
            android:textColor="@color/text_main"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvDiagnosticLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg_surface"
            android:padding="16dp"
            android:textColor="@color/cyan_glow"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:text="[INIT] DPC Started\n[DPM] Device Owner Active\n[MQTT] Broker: Connected (TLS)\n[GEO] Perimeter: In-Bounds" />

        <Button
            android:id="@+id/btnForceMqttSync"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="📡 Force MQTT Telemetry Publish"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/blue_primary"
            android:layout_marginTop="20dp" />

        <Button
            android:id="@+id/btnExitKioskMode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🔓 Temporary Kiosk Exit (Admin Only)"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/status_red"
            android:layout_marginTop="12dp" />

    </LinearLayout>
</ScrollView>
