<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#060911"
    android:fitsSystemWindows="true">

    <!-- ======================================================== -->
    <!-- 1. Top Executive Corporate Header Bar                    -->
    <!-- ======================================================== -->
    <LinearLayout
        android:id="@+id/hubHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:background="#0B1120">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️"
                android:textSize="20sp"
                android:layout_marginEnd="8dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHubBrandTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RRV MDM | Workspace"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    android:id="@+id/tvHubDeviceStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● Zero-Trust Enforced | Device Active"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </LinearLayout>

        <!-- Quick Sync Action Button -->
        <ImageButton
            android:id="@+id/btnHeaderSync"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_pill_filter"
            android:src="@android:drawable/ic_popup_sync"
            app:tint="#38BDF8"
            android:padding="8dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="Sync MDM Policy" />

        <!-- Exit / Minimize to Normal Home Screen Button -->
        <ImageButton
            android:id="@+id/btnHeaderExitHome"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_pill_filter"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#94A3B8"
            android:padding="8dp"
            android:contentDescription="Exit to Android Home Screen" />

    </LinearLayout>

    <!-- ======================================================== -->
    <!-- 2. Main Content Container (Tabs)                         -->
    <!-- ======================================================== -->
    <FrameLayout
        android:id="@+id/hubContentFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/hubHeaderBar"
        android:layout_above="@id/hubBottomNav">

        <!-- ==================================================== -->
        <!-- TAB 1: Managed Corporate App Store                   -->
        <!-- ==================================================== -->
        <LinearLayout
            android:id="@+id/layoutAppStore"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="14dp"
            android:visibility="visible">

            <!-- Search Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_search_bar"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔍"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/etStoreSearch"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="Search enterprise apps..."
                    android:textColorHint="#64748B"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:background="@null"
                    android:singleLine="true"
                    android:imeOptions="actionSearch" />
            </LinearLayout>

            <!-- Category Filter Pills -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/pillFilterAll"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="All Apps"
                        android:textColor="#0B1120"
                        android:background="@drawable/bg_pill_filter_active"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-bold"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/pillFilterMandatory"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="⚡ Mandatory"
                        android:textColor="#94A3B8"
                        android:background="@drawable/bg_pill_filter"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/pillFilterPrivate"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="📦 Private APKs"
                        android:textColor="#94A3B8"
                        android:background="@drawable/bg_pill_filter"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/pillFilterSystem"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="📱 System &amp; OEM"
                        android:textColor="#94A3B8"
                        android:background="@drawable/bg_pill_filter"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Store Apps RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvStoreApps"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="16dp" />

            <!-- Empty Store Notice -->
            <LinearLayout
                android:id="@+id/layoutStoreEmpty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛍️"
                    android:textSize="44sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Enterprise Applications Found"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-bold"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Applications published by your IT administrator will appear here."
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- ==================================================== -->
        <!-- TAB 1: Clean & Professional Workspace Home Dashboard -->
        <!-- ==================================================== -->
        <ScrollView
            android:id="@+id/layoutDashboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="20dp"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1. Executive Security & Enrollment Hero Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_app_card_dark"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_mdm_launcher"
                            android:layout_marginEnd="14dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDashboardOrgName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="RRV Enterprise Global"
                                android:textColor="#FFFFFF"
                                android:textSize="15sp"
                                android:fontFamily="sans-serif-bold" />

                            <TextView
                                android:id="@+id/tvDashboardModelName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Samsung Galaxy S21 (SM-G991B)"
                                android:textColor="#94A3B8"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Green Security Compliance Pill -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#1510B981"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🛡️"
                            android:textSize="16sp"
                            android:layout_marginEnd="10dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDashboardComplianceScore"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="● 100% Zero-Trust Compliant"
                                android:textColor="#10B981"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif-bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Knox Hardware Attested &amp; Enforced"
                                android:textColor="#34D399"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

                <!-- 2. Dual Status Metrics Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <!-- Metric 1: Policy Profile -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_app_card_dark"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🛡️ POLICY PROFILE"
                            android:textColor="#38BDF8"
                            android:textSize="10sp"
                            android:fontFamily="sans-serif-black" />

                        <TextView
                            android:id="@+id/tvDashboardPolicyName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Corporate High-Security"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-bold"
                            android:layout_marginTop="4dp"
                            android:maxLines="1"
                            android:ellipsize="end" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="● Synced &amp; Enforced"
                            android:textColor="#10B981"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <!-- Metric 2: Assigned Apps -->
                    <LinearLayout
                        android:id="@+id/btnDashboardGoToCatalog"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_app_card_dark"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:layout_marginStart="8dp"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🛍️ ASSIGNED APPS"
                            android:textColor="#38BDF8"
                            android:textSize="10sp"
                            android:fontFamily="sans-serif-black" />

                        <TextView
                            android:id="@+id/tvDashboardAppsCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 Apps"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-bold"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tap to View ➔"
                            android:textColor="#38BDF8"
                            android:textSize="10sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- 3. Clean Primary Action Buttons -->
                <Button
                    android:id="@+id/btnDashboardSyncNow"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="🔄 Sync Policy &amp; Telemetry On-Demand"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-bold"
                    android:background="@drawable/bg_btn_open"
                    android:layout_marginBottom="10dp" />

            </LinearLayout>
        </ScrollView>

        <!-- ==================================================== -->
        <!-- TAB 3: Diagnostics & Security Matrix                 -->
        <!-- ==================================================== -->
        <ScrollView
            android:id="@+id/layoutDiagnostics"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="18dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Telemetry Gauges Grid -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <!-- Battery Gauge Card -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_app_card_dark"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="14dp"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔋"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/tvDiagBatteryPct"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="94%"
                            android:textColor="#10B981"
                            android:textSize="20sp"
                            android:fontFamily="sans-serif-black" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Battery Health"
                            android:textColor="#94A3B8"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- RAM Gauge Card -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_app_card_dark"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="14dp"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🧠"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/tvDiagRamUsage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4.8 GB"
                            android:textColor="#38BDF8"
                            android:textSize="20sp"
                            android:fontFamily="sans-serif-black" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RAM Memory"
                            android:textColor="#94A3B8"
                            android:textSize="10sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Zero-Trust Security Checklist -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_app_card_dark"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ZERO-TRUST SECURITY CHECKLIST"
                        android:textColor="#38BDF8"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.05"
                        android:layout_marginBottom="10dp" />

                    <!-- Checklist Item 1: Passcode -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✅"
                            android:textSize="14sp"
                            android:layout_marginEnd="8dp" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Hardware Device Encryption"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PASS"
                            android:textColor="#10B981"
                            android:textSize="10sp"
                            android:fontFamily="sans-serif-bold" />
                    </LinearLayout>

                    <!-- Checklist Item 2: USB Debugging Blocked -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🚫"
                            android:textSize="14sp"
                            android:layout_marginEnd="8dp" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="USB Debugging &amp; Developer Mode"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BLOCKED"
                            android:textColor="#10B981"
                            android:textSize="10sp"
                            android:fontFamily="sans-serif-bold" />
                    </LinearLayout>

                    <!-- Checklist Item 3: Knox Attestation -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✅"
                            android:textSize="14sp"
                            android:layout_marginEnd="8dp" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Knox Hardware Integrity Attestation"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PASS"
                            android:textColor="#10B981"
                            android:textSize="10sp"
                            android:fontFamily="sans-serif-bold" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Button: Diagnostics Logs -->
                <Button
                    android:id="@+id/btnExportDiagLogs"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="📜 View Live Audit &amp; Event Logs"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-bold"
                    android:background="@drawable/bg_btn_open" />

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <!-- ======================================================== -->
    <!-- 3. Global Bottom Navigation Bar                          -->
    <!-- ======================================================== -->
    <LinearLayout
        android:id="@+id/hubBottomNav"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_alignParentBottom="true"
        android:background="#0B1120"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Nav Item 1: Home Dashboard -->
        <LinearLayout
            android:id="@+id/navTabHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏠"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvNavLabelHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Workspace"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Nav Item 2: App Store (Primary) -->
        <LinearLayout
            android:id="@+id/navTabAppStore"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛍️"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvNavLabelAppStore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="App Catalog"
                android:textColor="#38BDF8"
                android:textSize="10sp"
                android:fontFamily="sans-serif-bold"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Nav Item 3: Diagnostics -->
        <LinearLayout
            android:id="@+id/navTabDiagnostics"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvNavLabelDiagnostics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Diagnostics"
                android:textColor="#64748B"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="2dp" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
