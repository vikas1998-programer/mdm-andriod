<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- Outer Hexagonal Protective Shield -->
    <path
        android:pathData="M50,8 L88,26 L88,74 L50,92 L12,74 L12,26 Z"
        android:strokeWidth="2"
        android:strokeColor="#66ED0000">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="50"
                android:startY="8"
                android:endX="50"
                android:endY="92"
                android:type="linear">
                <item android:color="#20ED0000" android:offset="0.0"/>
                <item android:color="#00131620" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Kubernesis Dual-Pillar 'K' Geometry - Left Pillar -->
    <path
        android:pathData="M32,32 L41,32 L41,68 L32,68 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="32"
                android:startY="32"
                android:endX="41"
                android:endY="68"
                android:type="linear">
                <item android:color="#99EF4444" android:offset="0.0"/>
                <item android:color="#99ED0000" android:offset="1.0"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Upper Wing -->
    <path
        android:pathData="M46,50 L61,35 C63,33 66,34 66,37 L66,39 C66,41 65,42 64,43 L52,53 Z"
        android:fillColor="#99ED0000"/>

    <!-- Lower Wing -->
    <path
        android:pathData="M47,49 L64,66 C65,67 66,69 66,70 L66,72 C66,74 63,75 61,74 L45,57 Z"
        android:fillColor="#99ED0000"/>

    <!-- Tactical Security Node -->
    <path
        android:pathData="M50,18 A3,3 0 1,1 49.9,18 Z"
        android:fillColor="#990BB4AA"/>

</vector>
